# Git version control
.git/
.gitignore
.gitattributes

# Virtual environments
.venv/
venv/
env/
ENV/
.venv-ci/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Testing and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
test-results.xml
*.xml


# Local environment variables and secrets (NEVER bake into image)
.env
.env.*
backend/.env
!.env.example

# Node / Frontend development caches
node_modules/
frontend/node_modules/
frontend/.vite/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database backups and transient locks (seed netrisk.db is retained)
database/*backup*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
data/
*.sqlite

# IDE and OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# CI / Documentation / Evidence archives not required at runtime
NETRISK_PBL_Evidence/
_archived_web_frontend/
.scannerwork/
*.html
!frontend/**
!frontend_static/**
!backend/app/templates/**
*.md
!README.md
!DOCKER.md
