# ==========================================
# NETRISK Platform Environment Configuration
# ==========================================
PROJECT_NAME="NETRISK"
APP_ENV="production"
DEBUG=False

# ==========================================
# Database Configuration
# ==========================================
# For Local Host Execution:
# DATABASE_URL="sqlite:///database/netrisk.db"
#
# For Docker Container Execution (Persistent Volume Mounted at /app/data):
NETRISK_DATABASE_URL="sqlite:////app/data/netrisk.db"

# ==========================================
# Streamlit & Server Configuration
# ==========================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS="0.0.0.0"
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# ==========================================
# Atlassian Jira & Confluence Integration
# (Leave empty for Offline / Demo Mode)
# ==========================================
# Base URL of your Atlassian Cloud organization
JIRA_BASE_URL="https://sakec-team-bcq481n1.atlassian.net"

# Jira User Account Email (associated with API Token)
JIRA_EMAIL=""

# Jira API Token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=""

# Project Key for NETRISK in Jira
JIRA_PROJECT_KEY="NRASS"

# Confluence Space Key for Documentation
CONFLUENCE_SPACE_KEY="NRSS"
